      ],
      "parameters": {
        "jsCode": "const s={...$('Prepare ticket').item.json};const res=$json;const status=Number(res.statusCode||0);const b=res.body||{};const h=res.headers||{};const ra=h['retry-after'];const parsedDelay=ra===undefined?0:(Number.isFinite(Number(ra))?Number(ra):Math.ceil((Date.parse(ra)-Date.now())/1000));const resetDelay=h['x-ratelimit-remaining']==='0'?Math.ceil(Number(h['x-ratelimit-reset']||0)-Date.now()/1000):0;const retryAfter=Math.max(0,Number.isFinite(parsedDelay)?parsedDelay:60,resetDelay);s.stage='ticket';s.attempt=1;s.last_status=status;s.execution_id=$execution.id;s.retry=false;if(status===201&&typeof b.html_url==='string'){s.ticket_url=b.html_url;s.outcome='notification_pending';s.http_status=202;}else{const rate=status===429||(status===403&&('retry-after' in h||h['x-ratelimit-remaining']==='0'));s.retry=rate&&1<3&&retryAfter<=5;s.outcome=status===0||status>=500||status===201?'creation_uncertain':'ticket_failed';s.http_status=s.outcome==='creation_uncertain'?409:502;}\n s.wait_seconds=Math.max(1,retryAfter);return [{json:s}];"
