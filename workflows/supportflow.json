      ],
      "parameters": {
        "jsCode": "const v=$('Validate and classify').first().json;const old=$json.state?JSON.parse($json.state):null;let s={...v,ticket_url:null,attempt:0,execution_id:$execution.id};if(old){s={...old,execution_id:$execution.id};if(old.fingerprint!==v.fingerprint){s.outcome='request_id_conflict';s.http_status=409;s.action='respond';}else if(old.ticket_url && old.outcome!=='completed'){s.action='notify';}else{s.action='respond';s.http_status=old.outcome==='completed'?200:409;}}else{s.action='create';s.outcome='creation_uncertain';s.http_status=409;}return [{json:s}];"
      }
