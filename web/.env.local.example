# Server-only. Never prefix these with NEXT_PUBLIC_.
N8N_WEBHOOK_URL=https://YOUR-SUBDOMAIN.app.n8n.cloud/webhook/supportflow
# Raw secret only; the server adds the Bearer prefix.
N8N_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_HEADER_CREDENTIAL_VALUE
DEMO_ACCESS_CODE=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_16_CHARACTERS
# Published project source; change this if you fork it.
SOURCE_REPOSITORY_URL=https://github.com/ahamedfoisal/supportflow
# Optional exact origin; set to deployed origin in Vercel.
# APP_ORIGIN=https://your-demo.vercel.app
